# TEMPLATE ONLY. Copy outside Git to /etc/trendscope/api.env (mode 0600).
# Replace with: openssl rand -hex 32
JOB_API_ACCESS_TOKEN=
JOB_ALLOWED_ORIGINS=
# Public browsers use the Vercel same-origin proxy; this Bearer token stays server-side.
JOB_WORKER_MODE=cached
JOB_CACHE_MANIFEST=/opt/trendscope/config/cached_observations.json
JOB_REQUESTS_PER_MINUTE=120
JOB_NEW_JOBS_PER_DAY=10
# Only after offline verification and authorization, set JOB_WORKER_MODE=nasa.
# Then supply APPEEARS_TOKEN, or EARTHDATA_USER and EARTHDATA_PASS, server-side.
# No NASA credentials belong in the browser or Git.
