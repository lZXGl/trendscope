{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrendScopeResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "series", "trend", "verdict"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "lat", "lon", "variable", "unit", "source", "date_range"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "variable": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "is_mock": { "type": "boolean" },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
            "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
          }
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "raw", "anomaly"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "raw": { "type": ["number", "null"] },
          "anomaly": { "type": ["number", "null"] }
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "sens_slope", "slope_unit", "p_value", "tau", "significant", "autocorrected"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "sens_slope": { "type": "number" },
        "slope_unit": { "type": "string", "minLength": 1 },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "tau": { "type": "number", "minimum": -1, "maximum": 1 },
        "significant": { "type": "boolean" },
        "autocorrected": { "type": "boolean" }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "summary", "caveats"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
